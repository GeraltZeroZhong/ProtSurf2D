+std::vector<int> topologyStateSignature(const OptCuts::TriMesh& mesh)
+{
+    // A vertex-index-independent description of which face corners share a
+    // current mesh vertex. This is the cut topology because topology edits do
+    // not change the original face order.
+    std::vector<std::vector<int>> vertexCorners(mesh.V_rest.rows());
+    for(int face = 0; face < mesh.F.rows(); ++face) {
+        for(int corner = 0; corner < mesh.F.cols(); ++corner) {
+            const int vertex = mesh.F(face, corner);
+            if(vertex < 0 || vertex >= static_cast<int>(vertexCorners.size())) {
+                return std::vector<int>();
+            }
+            vertexCorners[vertex].push_back(face * mesh.F.cols() + corner);
+        }
+    }
+
+    std::vector<std::pair<std::vector<int>, int>> groups;
+    for(int vertex = 0; vertex < static_cast<int>(vertexCorners.size()); ++vertex) {
+        if(!vertexCorners[vertex].empty()) {
+            groups.push_back(std::make_pair(vertexCorners[vertex], vertex));
+        }
+    }
+    std::sort(groups.begin(), groups.end());
+    std::vector<int> canonicalVertex(mesh.V_rest.rows(), -1);
+    std::vector<int> signature;
+    signature.push_back(static_cast<int>(groups.size()));
+    for(int group = 0; group < static_cast<int>(groups.size()); ++group) {
+        canonicalVertex[groups[group].second] = group;
+        signature.push_back(static_cast<int>(groups[group].first.size()));
+        signature.insert(
+            signature.end(), groups[group].first.begin(), groups[group].first.end());
+    }
+
+    // Cohesive-edge bookkeeping controls the next merge candidates, so it is
+    // part of the state rather than inferred only from vertex/face counts.
+    std::vector<std::vector<int>> cohesiveRows;
+    for(int row = 0; row < mesh.cohE.rows(); ++row) {
+        std::vector<int> cohesiveRow;
+        for(int column = 0; column < mesh.cohE.cols(); ++column) {
+            const int vertex = mesh.cohE(row, column);
+            if(vertex < 0 || vertex >= static_cast<int>(canonicalVertex.size()) ||
+               canonicalVertex[vertex] < 0)
+            {
+                return std::vector<int>();
+            }
+            cohesiveRow.push_back(canonicalVertex[vertex]);
+        }
+        cohesiveRows.push_back(cohesiveRow);
+    }
+    std::sort(cohesiveRows.begin(), cohesiveRows.end());
+    signature.push_back(-1);
+    signature.push_back(static_cast<int>(cohesiveRows.size()));
+    for(const std::vector<int>& row : cohesiveRows) {
+        signature.insert(signature.end(), row.begin(), row.end());
+    }
+    return signature;
+}
