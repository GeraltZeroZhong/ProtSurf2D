+    void TriMesh::configureResidueFootprintEnergy(const std::string& path, double weight)
+    {
+        if(weight <= 0.0) {
+            residueFootprintWeight = 0.0;
+            return;
+        }
+        residueFootprintEnergy = TopoPPI::ResidueFootprintEnergy::load(path);
+        residueFootprintWeight = weight;
+        synchronizeResidueFootprints();
+        std::cout << "residue footprint energy enabled, weight=" << residueFootprintWeight
+                  << ", cycle rank=" << residueFootprintEnergy.cycleRank()
+                  << ", initial score=" << residueFootprintEnergy.score() << std::endl;
+    }
+
+    double TriMesh::residueFootprintScore(void) const
+    {
+        return residueFootprintWeight > 0.0 ? residueFootprintEnergy.score() : 0.0;
+    }
+
+    std::vector<TopoPPI::FootprintEdgeChange> TriMesh::residueFootprintChanges(
+        const std::vector<int>& path, bool cut) const
+    {
+        std::vector<TopoPPI::FootprintEdgeChange> changes;
+        if(residueFootprintWeight <= 0.0) {
+            return changes;
+        }
+        for(int index = 0; index + 1 < static_cast<int>(path.size()); ++index) {
+            const int edge = residueFootprintEnergy.edgeId(
+                sourceVertex[path[index]], sourceVertex[path[index + 1]]);
+            if(edge >= 0) {
+                changes.push_back(TopoPPI::FootprintEdgeChange(edge, cut));
+            }
+        }
+        return changes;
+    }
+
+    void TriMesh::synchronizeResidueFootprints(void)
+    {
+        if(residueFootprintWeight <= 0.0) {
+            return;
+        }
+        std::vector<int> faceVertices;
+        faceVertices.reserve(F.rows() * 3);
+        for(int face = 0; face < F.rows(); ++face) {
+            for(int corner = 0; corner < 3; ++corner) {
+                faceVertices.push_back(F(face, corner));
+            }
+        }
+        std::vector<int> sources(sourceVertex.data(), sourceVertex.data() + sourceVertex.size());
+        residueFootprintEnergy.synchronize(faceVertices, sources);
+    }
     
